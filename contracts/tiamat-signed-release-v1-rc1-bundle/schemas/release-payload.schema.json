{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoin.internal/contracts/tiamat-signed-release-v1/release-payload.schema.json",
  "title": "Tiamat signed release payload v1 RC1",
  "oneOf": [
    { "$ref": "#/$defs/executionProfile" },
    { "$ref": "#/$defs/privacyPolicy" },
    { "$ref": "#/$defs/spendingGrant" },
    { "$ref": "#/$defs/revocation" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x21-\\x7e]+$" },
    "realm": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "release_type", "release_id", "subject_id", "issuer", "environment", "caller_id", "realm", "issued_at", "not_before", "not_after", "sequence", "predecessor_release_id", "content_digest", "content"],
      "properties": {
        "format_version": { "const": "1" },
        "release_type": { "enum": ["execution_profile", "privacy_policy", "spending_grant", "revocation"] },
        "release_id": { "$ref": "#/$defs/id" },
        "subject_id": { "$ref": "#/$defs/id" },
        "issuer": { "$ref": "#/$defs/id" },
        "environment": { "$ref": "#/$defs/id" },
        "caller_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "realm": { "$ref": "#/$defs/realm" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "not_after": { "$ref": "#/$defs/timestamp" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "predecessor_release_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "content_digest": { "$ref": "#/$defs/digest" },
        "content": { "type": "object" }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_per_million_microusd", "output_per_million_microusd", "reasoning_per_million_microusd", "per_request_microusd"],
      "properties": {
        "input_per_million_microusd": { "type": "integer", "minimum": 0 },
        "output_per_million_microusd": { "type": "integer", "minimum": 0 },
        "reasoning_per_million_microusd": { "type": "integer", "minimum": 0 },
        "per_request_microusd": { "type": "integer", "minimum": 0 }
      }
    },
    "executionProfileContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "provider_route_id", "model_id", "allowed_output_modes", "maximum_input_tokens", "maximum_output_tokens", "maximum_context_tokens", "timeout_ceiling_ms", "privacy_policy_release_id", "data_collection", "training", "zero_data_retention_required", "fallback_allowed", "rate_release_id", "rates", "maximum_reservable_microusd"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/id" },
        "provider_route_id": { "$ref": "#/$defs/id" },
        "model_id": { "$ref": "#/$defs/id" },
        "allowed_output_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["text", "json_schema"] } },
        "maximum_input_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximum_context_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "timeout_ceiling_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "privacy_policy_release_id": { "$ref": "#/$defs/id" },
        "data_collection": { "const": "denied" },
        "training": { "const": "denied" },
        "zero_data_retention_required": { "const": true },
        "fallback_allowed": { "const": false },
        "rate_release_id": { "$ref": "#/$defs/id" },
        "rates": { "$ref": "#/$defs/rates" },
        "maximum_reservable_microusd": { "type": "integer", "minimum": 1 }
      }
    },
    "privacyPolicyContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "approved_provider_route_ids", "required_provider_privacy", "data_collection", "training", "fallback_allowed", "allowed_regions", "retention_ceiling_seconds", "eligibility_generation"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/id" },
        "approved_provider_route_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "required_provider_privacy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["zero_data_retention", "no_training", "no_data_collection"] } },
        "data_collection": { "const": "denied" },
        "training": { "const": "denied" },
        "fallback_allowed": { "const": false },
        "allowed_regions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$" } },
        "retention_ceiling_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "eligibility_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "spendingGrantContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_id", "budget_period_id", "period_start", "period_end", "allowance_microusd", "maximum_concurrency", "largest_per_call_microusd", "contingency_reserve_microusd"],
      "properties": {
        "partition_id": { "$ref": "#/$defs/id" },
        "budget_period_id": { "$ref": "#/$defs/id" },
        "period_start": { "$ref": "#/$defs/timestamp" },
        "period_end": { "$ref": "#/$defs/timestamp" },
        "allowance_microusd": { "type": "integer", "minimum": 1 },
        "maximum_concurrency": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "largest_per_call_microusd": { "type": "integer", "minimum": 1 },
        "contingency_reserve_microusd": { "type": "integer", "minimum": 1 }
      }
    },
    "releaseRevocationContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_release_type", "target_release_id", "reason_code", "effective_at", "eligibility_generation"],
      "properties": {
        "target_type": { "const": "release" },
        "target_release_type": { "enum": ["execution_profile", "privacy_policy", "spending_grant"] },
        "target_release_id": { "$ref": "#/$defs/id" },
        "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "effective_at": { "$ref": "#/$defs/timestamp" },
        "eligibility_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "executionProfile": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "release_type": { "const": "execution_profile" }, "content": { "$ref": "#/$defs/executionProfileContent" } } }] },
    "privacyPolicy": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "release_type": { "const": "privacy_policy" }, "content": { "$ref": "#/$defs/privacyPolicyContent" } } }] },
    "spendingGrant": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "release_type": { "const": "spending_grant" }, "content": { "$ref": "#/$defs/spendingGrantContent" } } }] },
    "revocation": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "release_type": { "const": "revocation" }, "content": { "$ref": "#/$defs/releaseRevocationContent" } } }] }
  }
}
