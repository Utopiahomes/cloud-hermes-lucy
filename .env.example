# Local development only. Production values come from a secrets manager.
LUCY_DATABASE_URL=postgresql+psycopg://lucy_app:local-app-only-change-me@postgres:5432/lucy
POSTGRES_DB=lucy
POSTGRES_USER=lucy_owner
POSTGRES_PASSWORD=local-only-change-me
LUCY_ADAPTER_TOKEN=replace-with-a-long-random-local-token
LUCY_MIGRATION_DATABASE_URL=postgresql+psycopg://lucy_owner:local-only-change-me@postgres:5432/lucy
LUCY_OBSERVED_HERMES_COMMIT=fcbd1076a93841fa88855acce810e342a5b78101
OPENROUTER_API_KEY=replace-with-your-openrouter-key
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
TELEGRAM_ALLOWED_USERS=replace-with-your-numeric-telegram-user-id
TELEGRAM_HOME_CHANNEL=replace-with-the-same-numeric-telegram-user-id

# Archive deployment remains gated. Local acceptance uses local-sqlite; Render
# production uses aws-kms-dynamodb with Render-managed web identity.
LUCY_TRANSCRIPT_CAPTURE_ENABLED=false
# Do not enable until the owner accepts the real-cloud retention/security report.
# LUCY_ALLOW_LOCAL_BOUNDARY_FALLBACK=true  # synthetic all-local tests only
# Never set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or
# AWS_WEB_IDENTITY_TOKEN_FILE in Render.
# LUCY_ARCHIVE_BACKEND=local-sqlite
# LUCY_ARCHIVE_KEYSTORE_PATH=/replace-with-an-absolute-local-path/archive-keys.sqlite3
# LUCY_ARCHIVE_KEK_B64=replace-with-32-random-bytes-base64
# LUCY_ARCHIVE_KEK_VERSION=local-v1
# LUCY_ARCHIVE_COMMITMENT_KEY_B64=replace-with-different-32-random-bytes-base64
# LUCY_OWNER_TOKEN=replace-with-a-different-long-random-owner-token
# LUCY_SERVICE_MODE=all-local
# LUCY_ENVIRONMENT=development
# LUCY_STORAGE_EPOCH=replace-with-the-operator-approved-storage-epoch-uuid
# Current HTTP startup also requires an independently initialized and operator-bound journal.
# These are LOCAL acceptance settings; production uses the DynamoDB settings below.
# LUCY_DELETION_JOURNAL_PATH=/replace-with-an-absolute-independent-path/deletions.sqlite
# LUCY_DELETION_JOURNAL_ID=replace-with-initialized-journal-uuid
# LUCY_ARCHIVE_REGISTRY_ID=replace-with-the-bound-registry-uuid
# The production adapter is implemented but remains blocked from live capture until cloud acceptance.
# The operator-only LUCY_MAINTENANCE_DATABASE_URL must never be passed to HTTP services.
# LUCY_OWNER_SUBJECT=owner:replace-with-stable-private-identifier
# LUCY_POLICY_GATEWAY_TOKEN=replace-with-a-policy-only-gateway-token
# LUCY_PERMIT_SIGNING_PRIVATE_KEY_B64=replace-with-32-byte-ed25519-private-key
# LUCY_PERMIT_SIGNING_PUBLIC_KEY_B64=replace-with-matching-32-byte-public-key

# Render production values (leave unset for local acceptance):
# LUCY_ARCHIVE_BACKEND=aws-kms-dynamodb
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-render-lucy-role
# LUCY_AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/replace-with-key-id
# LUCY_AWS_DYNAMODB_KEY_TABLE=replace-with-lucy-wrapped-key-table
# LUCY_AWS_DELETION_HEAD_TABLE=replace-with-lucy-deletion-head-table
# LUCY_AWS_DELETION_INTENT_TABLE=replace-with-lucy-deletion-intent-table
# LUCY_DELETION_JOURNAL_ID=replace-with-the-cloudformation-journal-uuid
# LUCY_ARCHIVE_REGISTRY_ID=replace-with-the-cloudformation-registry-uuid

# Security Baseline v1.2 values are service-specific. Do not put every value in
# one shared Render environment group; use deploy/render/security-baseline-v1.2.yaml.example.
# LUCY_SECURITY_ENVIRONMENT=production
# LUCY_SECURITY_STORAGE_EPOCH=replace-with-positive-integer
# LUCY_SECURITY_REGISTRY_EPOCH=replace-with-positive-integer
# LUCY_SECURITY_KEY_EPOCH=replace-with-positive-integer
# LUCY_ARCHIVE_RECORD_VERSION=1
# R1 V1.3 realm archive process only. Use a different 32-byte key from the
# plaintext commitment key above; PostgreSQL receives only this keyed digest.
# LUCY_ARCHIVE_REQUEST_COMMITMENT_KEY_B64=replace-with-separate-32-random-bytes-base64
# LUCY_V13_TARGET_SCOPE_JSON=replace-with-deployment-owned-origin-scope-json
# LUCY_AWS_ACCOUNT_ID=123456789012
# LUCY_AWS_EVIDENCE_KEY_ARN=replace-with-realm-stamp-output
# LUCY_AWS_WRAPPED_KEY_TABLE=replace-with-realm-stamp-output
#
# Policy only (no AWS role):
# V1.2 names below remain frozen for the accepted enclave. V1.3 uses distinct
# names so a service cannot silently mix contract generations.
# LUCY_POLICY_SIGNING_PRIVATE_KEY_B64=replace-with-32-byte-ed25519-private-seed
# LUCY_POLICY_KEY_ID=policy-notary.production.1
# LUCY_POLICY_ISSUER=lucy-policy
# LUCY_OWNER_TRUST_STORE_JSON=replace-with-reviewed-public-key-inventory
# LUCY_EXECUTOR_RECEIPT_TRUST_STORE_JSON=replace-with-reviewed-public-key-inventory
# LUCY_RETRIEVAL_EXECUTOR_IDENTITY=lucy-evidence-executor
# LUCY_RETRIEVAL_EXECUTOR_ALIAS_ARN=replace-with-qualified-cloudformation-output
# LUCY_RETRIEVAL_EXECUTOR_VERSION=replace-with-published-version
# LUCY_DELETION_EXECUTOR_IDENTITY=lucy-deletion-executor
# LUCY_DELETION_EXECUTOR_ALIAS_ARN=replace-with-qualified-cloudformation-output
# LUCY_DELETION_EXECUTOR_VERSION=replace-with-published-version
# LUCY_V13_POLICY_SIGNING_PRIVATE_KEY_B64=replace-with-32-byte-ed25519-private-seed
# LUCY_V13_POLICY_KEY_ID=replace-with-realm-policy-key-id
# LUCY_V13_POLICY_TRUST_STORE_JSON=replace-with-v1.3-policy-public-key-inventory
# LUCY_V13_RECEIPT_TRUST_STORE_JSON=replace-with-v1.3-receipt-public-key-inventory
# LUCY_V13_TARGET_SCOPE_JSON=replace-with-exact-realm-origin-scope
# LUCY_V13_EXECUTION_BINDING_JSON=replace-with-exact-realm-execution-binding
# LUCY_V13_CALLER_IDENTITY=replace-with-realm-archive-role-arn
# LUCY_MEMORY_OUTCOME_POLICY_VERSION=1
#
# Evidence/deletion callers only (one exact alias per service):
# LUCY_POLICY_HOSTPORT=provided-by-Render-private-service-discovery
# LUCY_AWS_RETRIEVAL_EXECUTOR_ALIAS_ARN=replace-on-evidence-only
# LUCY_AWS_DELETION_EXECUTOR_ALIAS_ARN=replace-on-deletion-only
# LUCY_AWS_OUTCOME_KEY_ARN=replace-on-routine-only
# LUCY_AWS_OUTCOME_KEY_TABLE=replace-on-routine-only
# LUCY_OUTCOME_REGISTRY_ID=replace-on-routine-only
# LUCY_AWS_OUTCOME_RECOVERY_ALIAS_ARN=replace-on-routine-only
#
# Operator-triggered finality utility only:
# LUCY_AWS_WRAPPED_KEY_TABLE=replace-with-cloudformation-output
# LUCY_FINALITY_QUARANTINE_TABLE_PREFIX=replace-resource-namespace-quarantine-

# Hermes private-service routing in production. Each token is independent.
# LUCY_POLICY_URL=http://lucy-policy:8080
# LUCY_POLICY_TOKEN=replace-with-LUCY_POLICY_GATEWAY_TOKEN
# LUCY_EVIDENCE_URL=http://lucy-evidence:8080
# LUCY_EVIDENCE_TOKEN=replace-with-evidence-adapter-token
# LUCY_DELETION_URL=http://lucy-deletion:8080
# LUCY_DELETION_TOKEN=replace-with-deletion-adapter-token

# Isolated approved-public-projection service only. Keep these values off every
# private Lucy service; use the reviewed Render blueprint for production.
# LUCY_SERVICE_MODE=public
# LUCY_EXPECTED_DATABASE_LOGIN=lucy_utopia_public
# LUCY_DATABASE_URL=postgresql+psycopg://lucy_utopia_public:replace-secret@replace-private-host/lucy
# LUCY_PUBLIC_API_TOKEN=replace-with-a-long-random-site-to-cloud-token
# LUCY_PUBLIC_ALLOWED_ORIGIN=https://www.utopiahomes.com
# LUCY_PUBLIC_SITE_HOSTNAME=www.utopiahomes.com
# LUCY_PUBLIC_SNAPSHOT_DIGEST=replace-with-reviewed-lowercase-sha256
# LUCY_PUBLIC_MAX_REQUEST_BYTES=8192
# LUCY_PUBLIC_REQUESTS_PER_IP_PER_MINUTE=20
# LUCY_PUBLIC_REQUESTS_PER_SESSION_PER_MINUTE=30
# LUCY_PUBLIC_SESSION_TTL_SECONDS=3600
# LUCY_PUBLIC_CONVERSATION_ENABLED=false
# Model handoff stays disabled until the separate private model service, exact
# provider route, cost policy, and snapshot allowlist pass production commissioning.
# LUCY_PUBLIC_MODEL_ENABLED=false
# LUCY_PUBLIC_MODEL_HOSTPORT=provided-by-Render-private-service-discovery
# LUCY_PUBLIC_MODEL_TOKEN=replace-with-public-to-model-private-token
# LUCY_PUBLIC_COST_COMMITMENT_KEY_B64=replace-with-32-random-bytes-base64
# Reproduction staging only. The operator credential never goes to a browser or Claude.
# LUCY_PUBLIC_DIAGNOSTICS_ENABLED=false
# LUCY_PUBLIC_DIAGNOSTIC_TOKEN=replace-with-operator-only-diagnostic-token
# LUCY_PUBLIC_RELEASE_ID=replace-with-exact-40-character-cloud-commit
# LUCY_PUBLIC_DEPLOYMENT_TIER=staging
# LUCY_PUBLIC_DIAGNOSTIC_TTL_SECONDS=3600
# LUCY_PUBLIC_DIAGNOSTIC_MAX_RECEIPTS=200
# LUCY_PUBLIC_EXERCISE_MODE=false
# LUCY_PUBLIC_EXERCISE_CONCURRENCY_LIMIT=2
# LUCY_PUBLIC_EXERCISE_SESSION_REQUEST_LIMIT=20
# LUCY_PUBLIC_EXERCISE_TOTAL_REQUEST_LIMIT=40

# Isolated Public Lucy model service only. The OpenRouter credential and cost
# identity must never be placed on lucy-public or the website.
# LUCY_SERVICE_MODE=public-model
# LUCY_PUBLIC_MODEL_DATABASE_URL=postgresql+psycopg://lucy_utopia_cost_admission:replace-secret@replace-private-host/lucy
# LUCY_PUBLIC_MODEL_EXPECTED_DATABASE_LOGIN=lucy_utopia_cost_admission
# LUCY_PUBLIC_MODEL_TOKEN=replace-with-public-to-model-private-token
# LUCY_PUBLIC_MODEL_ALLOWED_SNAPSHOT_DIGESTS=replace-with-current-and-staged-sha256-values
# LUCY_PUBLIC_MODEL_NODE_ID=replace-with-public-node-uuid
# LUCY_PUBLIC_MODEL_CHANNEL_BINDING_ID=replace-with-public-channel-binding-uuid
# LUCY_PUBLIC_MODEL_ID=google/gemini-3.1-flash-lite
# LUCY_PUBLIC_MODEL_ALLOWED_PROVIDERS=replace-with-reviewed-OpenRouter-provider-slug
# LUCY_PUBLIC_MODEL_RATE_VERSION=replace-with-reviewed-rate-version
# LUCY_PUBLIC_MODEL_MAX_PROMPT_USD_PER_MILLION=0.8
# LUCY_PUBLIC_MODEL_MAX_COMPLETION_USD_PER_MILLION=4
# LUCY_PUBLIC_MODEL_GENERATOR_MAX_MICROUSD=30000
# LUCY_PUBLIC_MODEL_VERIFIER_MAX_MICROUSD=15000
# LUCY_PUBLIC_MODEL_GENERATOR_MAX_TOKENS=700
# LUCY_PUBLIC_MODEL_VERIFIER_MAX_TOKENS=300
# LUCY_PUBLIC_MODEL_TIMEOUT_SECONDS=6
# LUCY_PUBLIC_MODEL_MAX_REQUEST_BYTES=200000
# LUCY_PUBLIC_MODEL_REQUEST_COMMITMENT_KEY_B64=replace-with-32-random-bytes-base64
# LUCY_PUBLIC_MODEL_PROVIDER_REFERENCE_KEY_B64=replace-with-different-32-random-bytes-base64
# LUCY_COST_WRITER_HOSTPORT=provided-by-Render-private-service-discovery
# LUCY_COST_WRITER_TOKEN=replace-with-cost-writer-private-token
# LUCY_RECOVERY_ACK_HOSTPORT=provided-by-Render-private-service-discovery
# LUCY_RECOVERY_ACK_TOKEN=replace-with-cost-acknowledgement-private-token
# OPENROUTER_API_KEY=replace-with-dedicated-account-capped-public-model-key
# Must equal the exact deployed Cloud source commit when diagnostics are enabled.
# LUCY_PUBLIC_DIAGNOSTICS_ENABLED=false
# LUCY_PUBLIC_MODEL_RELEASE_ID=replace-with-exact-40-character-cloud-commit

# Ephemeral migration-only Public Lucy R1 release job. These values never belong
# on a continuously running service. Stage, approve, and activate use distinct
# exact authorization markers and independently reviewed manifests.
# LUCY_PUBLIC_KNOWLEDGE_AUTHORIZATION=replace-with-exact-action-authorization
# LUCY_PUBLIC_KNOWLEDGE_MANIFEST_JSON=replace-with-reviewed-identifier-only-manifest
# LUCY_PUBLIC_KNOWLEDGE_MANIFEST_SHA256=replace-with-reviewed-manifest-sha256
# LUCY_PUBLIC_KNOWLEDGE_SNAPSHOT_PATH=/app/deploy/render/utopia-public-knowledge.r1.json

# Stoin Control management reader only. The dedicated Ed25519 seed must not be
# reused by policy, receipts, deployment, customer identity, or business calls.
# The Homes management adapter URL is provisioned out of band; no endpoint is
# discovered from a request or supplied by a caller.
# STOIN_MANAGEMENT_JWT_PRIVATE_KEY_B64=replace-with-dedicated-32-byte-ed25519-seed
# STOIN_MANAGEMENT_JWT_KEY_ID=replace-with-provisioned-management-reader-key-id
# One-shot non-production commissioning job only. The URL is deployment-owned,
# fixed, HTTPS-only, and has no path. The expected release is not a secret.
# STOIN_MANAGEMENT_PROVIDER_BASE_URL=https://replace-with-staging-adapter-origin
# STOIN_MANAGEMENT_EXPECTED_PROVIDER_RELEASE_ID=replace-with-exact-staged-release-id
