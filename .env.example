# Local development only. Production values come from a secrets manager.
LUCY_DATABASE_URL=postgresql+psycopg://lucy_app:local-app-only-change-me@postgres:5432/lucy
POSTGRES_DB=lucy
POSTGRES_USER=lucy_owner
POSTGRES_PASSWORD=local-only-change-me
LUCY_ADAPTER_TOKEN=replace-with-a-long-random-local-token
LUCY_MIGRATION_DATABASE_URL=postgresql+psycopg://lucy_owner:local-only-change-me@postgres:5432/lucy
LUCY_OBSERVED_HERMES_COMMIT=fcbd1076a93841fa88855acce810e342a5b78101
OPENROUTER_API_KEY=replace-with-your-openrouter-key
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
TELEGRAM_ALLOWED_USERS=replace-with-your-numeric-telegram-user-id
TELEGRAM_HOME_CHANNEL=replace-with-the-same-numeric-telegram-user-id

# Archive deployment remains gated. Local acceptance uses local-sqlite; Render
# production uses aws-kms-dynamodb with Render-managed web identity.
# Never set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or
# AWS_WEB_IDENTITY_TOKEN_FILE in Render.
# LUCY_ARCHIVE_BACKEND=local-sqlite
# LUCY_ARCHIVE_KEYSTORE_PATH=/replace-with-an-absolute-local-path/archive-keys.sqlite3
# LUCY_ARCHIVE_KEK_B64=replace-with-32-random-bytes-base64
# LUCY_ARCHIVE_KEK_VERSION=local-v1
# LUCY_ARCHIVE_COMMITMENT_KEY_B64=replace-with-different-32-random-bytes-base64
# LUCY_OWNER_TOKEN=replace-with-a-different-long-random-owner-token
# LUCY_SERVICE_MODE=all-local
# LUCY_OWNER_SUBJECT=owner:replace-with-stable-private-identifier
# LUCY_POLICY_GATEWAY_TOKEN=replace-with-a-policy-only-gateway-token
# LUCY_PERMIT_SIGNING_PRIVATE_KEY_B64=replace-with-32-byte-ed25519-private-key
# LUCY_PERMIT_SIGNING_PUBLIC_KEY_B64=replace-with-matching-32-byte-public-key

# Render production values (leave unset for local acceptance):
# LUCY_ARCHIVE_BACKEND=aws-kms-dynamodb
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-render-lucy-role
# LUCY_AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/replace-with-key-id
# LUCY_AWS_DYNAMODB_KEY_TABLE=replace-with-lucy-wrapped-key-table

# Hermes private-service routing in production. Each token is independent.
# LUCY_POLICY_URL=http://lucy-policy:8080
# LUCY_POLICY_TOKEN=replace-with-LUCY_POLICY_GATEWAY_TOKEN
# LUCY_EVIDENCE_URL=http://lucy-evidence:8080
# LUCY_EVIDENCE_TOKEN=replace-with-evidence-adapter-token
# LUCY_DELETION_URL=http://lucy-deletion:8080
# LUCY_DELETION_TOKEN=replace-with-deletion-adapter-token
