{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LucyArchiveEnvelopeOnly",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "${LUCY_KMS_KEY_ARN}",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:application": "cloud-hermes-lucy"
        },
        "ForAllValues:StringEquals": {
          "kms:EncryptionContextKeys": [
            "application",
            "evidence-id"
          ]
        },
        "ForAnyValue:StringEquals": {
          "kms:EncryptionContextKeys": "evidence-id"
        }
      }
    },
    {
      "Sid": "LucyWrappedKeyRegistryOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${LUCY_DYNAMODB_TABLE}"
    }
  ]
}
