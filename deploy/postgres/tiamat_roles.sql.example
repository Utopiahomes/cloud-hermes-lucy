-- Render with render_tiamat_role_template_v1.py and run as the dedicated Tiamat database owner
-- after migration 0005. The database identifier is deliberately a required placeholder so this
-- template cannot silently grant access to a differently named database.
-- Supply passwords through the platform secret manager; never place them in this file.
-- The serving login must not own tables, inherit the owner, or hold BYPASSRLS/SUPERUSER.

CREATE ROLE tiamat_runtime LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
-- Recovery is an offline, separately held credential. BYPASSRLS is required to reconcile every
-- caller partition, and this role must never be supplied to a serving process.
CREATE ROLE tiamat_recovery LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION BYPASSRLS;
CREATE ROLE tiamat_release_manager LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;

GRANT CONNECT ON DATABASE __TIAMAT_DATABASE__ TO tiamat_runtime, tiamat_recovery, tiamat_release_manager;
GRANT USAGE ON SCHEMA tiamat TO tiamat_runtime, tiamat_recovery, tiamat_release_manager;

GRANT SELECT, INSERT, UPDATE, DELETE ON
  tiamat.jti_replay,
  tiamat.spending_partitions,
  tiamat.execution_records,
  tiamat.grant_releases,
  tiamat.route_rate_quarantines,
  tiamat.financial_events
TO tiamat_runtime;
GRANT SELECT, UPDATE ON tiamat.restore_gate TO tiamat_runtime;
-- Only the migration/recovery boundary reads the database-global ledger identity. Serving
-- processes receive neither this grant nor any ability to select another environment's state.
GRANT SELECT ON tiamat.ledger_identity TO tiamat_recovery;
GRANT SELECT ON tiamat.trust_inventories, tiamat.signed_releases, tiamat.release_heads
TO tiamat_runtime;

GRANT SELECT, INSERT, UPDATE ON
  tiamat.trust_inventories,
  tiamat.signed_releases,
  tiamat.release_heads
TO tiamat_release_manager;
GRANT SELECT ON tiamat.restore_gate TO tiamat_release_manager;

GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA tiamat TO tiamat_recovery;

ALTER DEFAULT PRIVILEGES IN SCHEMA tiamat REVOKE ALL ON TABLES FROM PUBLIC;
REVOKE ALL ON SCHEMA tiamat FROM PUBLIC;
REVOKE ALL ON ALL TABLES IN SCHEMA tiamat FROM PUBLIC;
