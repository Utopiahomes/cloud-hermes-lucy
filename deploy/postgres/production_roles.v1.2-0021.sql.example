-- Frozen Security Baseline v1.2 grants for migration 0021. This template is
-- intentionally revision-bound: current realm grants belong to the v1.3
-- commissioner and must not be applied while preparing its historical source.

DO $validation$
DECLARE
  v_login text;
  v_logins text[] := ARRAY[
    '__LUCY_ROUTINE_LOGIN__','__LUCY_POLICY_LOGIN__','__LUCY_EVIDENCE_LOGIN__',
    '__LUCY_DELETION_LOGIN__','__LUCY_FINALITY_LOGIN__'
  ];
BEGIN
  IF (SELECT count(DISTINCT value) FROM unnest(v_logins) AS value) <> 5 THEN
    RAISE EXCEPTION 'v1.2 service LOGIN identifiers must be distinct';
  END IF;
  FOREACH v_login IN ARRAY v_logins LOOP
    IF NOT EXISTS (
      SELECT 1 FROM pg_roles
      WHERE rolname=v_login AND rolcanlogin AND NOT rolsuper AND NOT rolcreaterole
        AND NOT rolcreatedb AND NOT rolinherit AND NOT rolreplication
        AND NOT rolbypassrls
    ) THEN
      RAISE EXCEPTION 'missing or elevated v1.2 service LOGIN: %', v_login;
    END IF;
    IF EXISTS (
      SELECT 1 FROM pg_auth_members m JOIN pg_roles r ON r.oid=m.member
      WHERE r.rolname=v_login
    ) THEN
      RAISE EXCEPTION 'v1.2 service LOGIN has inherited role membership: %', v_login;
    END IF;
  END LOOP;
END
$validation$;

DO $database_grants$
BEGIN
  EXECUTE format(
    'REVOKE CONNECT, TEMP ON DATABASE %I FROM '
    '"__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", '
    '"__LUCY_EVIDENCE_LOGIN__", "__LUCY_DELETION_LOGIN__", '
    '"__LUCY_FINALITY_LOGIN__"',
    current_database()
  );
  EXECUTE format(
    'GRANT CONNECT ON DATABASE %I TO '
    '"__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", '
    '"__LUCY_EVIDENCE_LOGIN__", "__LUCY_DELETION_LOGIN__", '
    '"__LUCY_FINALITY_LOGIN__"',
    current_database()
  );
END
$database_grants$;

REVOKE ALL ON SCHEMA lucy, public FROM
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__", "__LUCY_FINALITY_LOGIN__";
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA lucy FROM
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__", "__LUCY_FINALITY_LOGIN__";
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA lucy FROM
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__", "__LUCY_FINALITY_LOGIN__";
REVOKE ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA lucy FROM
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__", "__LUCY_FINALITY_LOGIN__";

GRANT USAGE ON SCHEMA lucy TO
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__", "__LUCY_FINALITY_LOGIN__";
GRANT SELECT ON public.alembic_version TO
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__";
GRANT SELECT ON lucy.lifecycle, lucy.runtime_admission TO
  "__LUCY_ROUTINE_LOGIN__", "__LUCY_POLICY_LOGIN__", "__LUCY_EVIDENCE_LOGIN__",
  "__LUCY_DELETION_LOGIN__";

GRANT SELECT, INSERT, UPDATE ON
  lucy.operations,
  lucy.budget_accounts, lucy.budget_reservations, lucy.approval_requests,
  lucy.memory_claims, lucy.memory_entities, lucy.memory_relationships,
  lucy.working_contexts, lucy.memory_corrections, lucy.memory_write_proposals,
  lucy.action_executions, lucy.conversation_capture_states, lucy.conversation_turns
TO "__LUCY_ROUTINE_LOGIN__";
GRANT SELECT (id), INSERT ON lucy.evidence TO "__LUCY_ROUTINE_LOGIN__";
GRANT SELECT, UPDATE ON lucy.audit_head TO "__LUCY_ROUTINE_LOGIN__";
GRANT SELECT, INSERT ON lucy.audit_events TO "__LUCY_ROUTINE_LOGIN__";
GRANT INSERT ON lucy.evidence_payloads TO "__LUCY_ROUTINE_LOGIN__";
GRANT SELECT ON lucy.evidence_tombstones, lucy.evidence_deletion_fences_v1
  TO "__LUCY_ROUTINE_LOGIN__";
GRANT SELECT, INSERT ON lucy.capture_receipts, lucy.evidence_derivations,
  lucy.claim_sources, lucy.proposal_sources, lucy.correction_sources
TO "__LUCY_ROUTINE_LOGIN__";
GRANT SELECT ON lucy.deletion_journal_binding, lucy.deletion_journal_receipts
  TO "__LUCY_ROUTINE_LOGIN__";

GRANT EXECUTE ON FUNCTION
  lucy.issue_sensitive_action_permit_v2(jsonb,jsonb,text),
  lucy.prepare_deletion_scope_v1(uuid,uuid,text),
  lucy.finalize_deletion_scope_v1(uuid,jsonb,jsonb),
  lucy.read_claim_digest_for_notary_v1(uuid),
  lucy.store_sensitive_execution_grant_v1(uuid,jsonb),
  lucy.attest_executor_receipt_v1(uuid,jsonb)
TO "__LUCY_POLICY_LOGIN__";

GRANT EXECUTE ON FUNCTION
  lucy.claim_evidence_retrieval_v1(jsonb,text),
  lucy.reconcile_evidence_retrieval_v1(uuid),
  lucy.record_evidence_delivery_v1(uuid,text)
TO "__LUCY_EVIDENCE_LOGIN__";
GRANT EXECUTE ON FUNCTION
  lucy.claim_evidence_deletion_v1(jsonb,jsonb,text),
  lucy.reconcile_evidence_deletion_v1(uuid)
TO "__LUCY_DELETION_LOGIN__";

GRANT EXECUTE ON FUNCTION lucy.record_finality_verification_v1(uuid,jsonb)
TO "__LUCY_FINALITY_LOGIN__";
