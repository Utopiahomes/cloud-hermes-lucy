-- Fresh-cluster bootstrap, run once by the database role administrator before
-- migrations. Do not grant lucy_app to any production login: old immutable
-- migrations name this inert compatibility role. It must remain NOLOGIN.
-- Existing conflicting roles cause a deliberate error, not silent adoption.
CREATE ROLE lucy_app NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE lucy_routine NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE lucy_policy NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE lucy_evidence_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE lucy_evidence_deleter NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
CREATE ROLE lucy_security_function_owner NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
  NOINHERIT NOREPLICATION NOBYPASSRLS;
-- The fixed production migration identity from the v1.2 Render Blueprint may
-- install/re-own reviewed functions.
-- Runtime logins are never members of this role.
GRANT lucy_security_function_owner TO lucy_migration;
