# Render Blueprint example. Create the four private services first, then use
# their immutable IDs as inputs to deploy/aws/security-baseline-v1.1.yaml.
# Secret values and database URLs are entered in Render and never committed.
services:
  - type: pserv
    name: lucy-routine
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerContext: .
    envVars:
      - key: LUCY_SERVICE_MODE
        value: routine
      - key: LUCY_ENVIRONMENT
        value: production
      - key: LUCY_STORAGE_EPOCH
        sync: false
      - key: LUCY_TRANSCRIPT_CAPTURE_ENABLED
        value: "false"
      - key: LUCY_DATABASE_URL
        sync: false
      - key: LUCY_OBSERVED_HERMES_COMMIT
        sync: false
      - key: LUCY_ADAPTER_TOKEN
        sync: false
      - key: LUCY_ARCHIVE_BACKEND
        value: aws-kms-dynamodb
      - key: AWS_REGION
        value: us-east-1
      - key: AWS_ROLE_ARN
        sync: false
      - key: LUCY_AWS_KMS_KEY_ARN
        sync: false
      - key: LUCY_AWS_DYNAMODB_KEY_TABLE
        sync: false
      - key: LUCY_ARCHIVE_REGISTRY_ID
        sync: false
      - key: LUCY_DELETION_JOURNAL_ID
        sync: false
      - key: LUCY_AWS_DELETION_HEAD_TABLE
        sync: false
      - key: LUCY_AWS_DELETION_INTENT_TABLE
        sync: false
      - key: LUCY_ARCHIVE_COMMITMENT_KEY_B64
        sync: false

  - type: pserv
    name: lucy-policy
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerContext: .
    envVars:
      - key: LUCY_SERVICE_MODE
        value: policy
      - key: LUCY_ENVIRONMENT
        value: production
      - key: LUCY_STORAGE_EPOCH
        sync: false
      - key: LUCY_DATABASE_URL
        sync: false
      - key: LUCY_OBSERVED_HERMES_COMMIT
        sync: false
      - key: LUCY_OWNER_TOKEN
        sync: false
      - key: LUCY_POLICY_GATEWAY_TOKEN
        sync: false
      - key: LUCY_OWNER_SUBJECT
        sync: false
      - key: LUCY_PERMIT_SIGNING_PRIVATE_KEY_B64
        sync: false

  - type: pserv
    name: lucy-evidence
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerContext: .
    envVars:
      - key: LUCY_SERVICE_MODE
        value: evidence
      - key: LUCY_ENVIRONMENT
        value: production
      - key: LUCY_STORAGE_EPOCH
        sync: false
      - key: LUCY_DATABASE_URL
        sync: false
      - key: LUCY_OBSERVED_HERMES_COMMIT
        sync: false
      - key: LUCY_ADAPTER_TOKEN
        sync: false
      - key: LUCY_OWNER_TOKEN
        sync: false
      - key: LUCY_ARCHIVE_BACKEND
        value: aws-kms-dynamodb
      - key: AWS_REGION
        value: us-east-1
      - key: AWS_ROLE_ARN
        sync: false
      - key: LUCY_AWS_KMS_KEY_ARN
        sync: false
      - key: LUCY_AWS_DYNAMODB_KEY_TABLE
        sync: false
      - key: LUCY_ARCHIVE_REGISTRY_ID
        sync: false
      - key: LUCY_DELETION_JOURNAL_ID
        sync: false
      - key: LUCY_AWS_DELETION_HEAD_TABLE
        sync: false
      - key: LUCY_AWS_DELETION_INTENT_TABLE
        sync: false
      - key: LUCY_ARCHIVE_COMMITMENT_KEY_B64
        sync: false
      - key: LUCY_PERMIT_SIGNING_PUBLIC_KEY_B64
        sync: false

  - type: pserv
    name: lucy-deletion
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerContext: .
    envVars:
      - key: LUCY_SERVICE_MODE
        value: deletion
      - key: LUCY_ENVIRONMENT
        value: production
      - key: LUCY_STORAGE_EPOCH
        sync: false
      - key: LUCY_DATABASE_URL
        sync: false
      - key: LUCY_OBSERVED_HERMES_COMMIT
        sync: false
      - key: LUCY_ADAPTER_TOKEN
        sync: false
      - key: LUCY_OWNER_TOKEN
        sync: false
      - key: LUCY_ARCHIVE_BACKEND
        value: aws-kms-dynamodb
      - key: AWS_REGION
        value: us-east-1
      - key: AWS_ROLE_ARN
        sync: false
      - key: LUCY_AWS_DYNAMODB_KEY_TABLE
        sync: false
      - key: LUCY_ARCHIVE_REGISTRY_ID
        sync: false
      - key: LUCY_DELETION_JOURNAL_ID
        sync: false
      - key: LUCY_AWS_DELETION_HEAD_TABLE
        sync: false
      - key: LUCY_AWS_DELETION_INTENT_TABLE
        sync: false
      - key: LUCY_PERMIT_SIGNING_PUBLIC_KEY_B64
        sync: false
